<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext разрешён только для сервера разработки (эмулятор: 10.0.2.2 = хост).
     Общий cleartext остаётся запрещённым; реальный поставщик должен работать по HTTPS (ТЗ §8). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
