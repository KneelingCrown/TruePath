# Подключение к БД. По умолчанию — локальный SQLite.
DATABASE_URL=sqlite:///./truepath.db

# Каталог для загруженных файлов материалов.
UPLOADS_DIR=./uploads

# Бюджет дополнительного поиска (этап 5 пайплайна): максимум запросов.
EXTRA_SEARCH_MAX_QUERIES=3

# Текущий этап — без внешних API и ключей (по ТЗ). Адаптеры работают на заглушках.
